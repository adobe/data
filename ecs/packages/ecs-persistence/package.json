{
  "name": "@adobe/ecs-persistence",
  "version": "0.0.1",
  "description": "Saving, loading and copying the entities of @adobe/ecs worlds, as binary columns",
  "license": "MIT",
  "type": "module",
  "sideEffects": true,
  "private": false,
  "independentVersion": true,
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test-helper.ts",
    "LICENSE"
  ],
  "scripts": {
    "build": "cp ../../LICENSE . && tsc -p tsconfig.build.json && vite build",
    "typecheck": "tsc && tsc -p tsconfig.build.json",
    "test": "vitest --run",
    "test:perf": "vitest --run --config vitest.perf.config.ts"
  },
  "dependencies": {
    "@adobe/ecs": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "ecs-guide-checks": "workspace:*",
    "typescript": "^5.8.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/types/index.d.ts"
    }
  },
  "guide": {
    "files": [
      "src/**/*.ts",
      "dist/**/*.js"
    ]
  }
}
