{
  "name": "ecs-sample-browser",
  "version": "0.0.0",
  "description": "The ECS's sample browser: every sample package beside it, served from one dev server, a tab each",
  "license": "MIT",
  "type": "module",
  "private": true,
  "pages": [
    { "from": "dist", "to": "ecs/samples" }
  ],
  "scripts": {
    "build": "tsc && vite build",
    "dev": "vite",
    "typecheck": "tsc",
    "test": "pnpm exec playwright install chromium && vitest --run"
  },
  "dependencies": {
    "@adobe/ecs": "workspace:*",
    "@spectrum-web-components/theme": "^1.12.5"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@webgpu/types": "^0.1.61",
    "playwright": "^1.64.1",
    "typescript": "^5.8.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
