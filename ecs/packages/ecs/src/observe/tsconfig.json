{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "..",
    "outDir": "../../dist",
    "tsBuildInfoFile": "../../dist/observe/tsconfig.tsbuildinfo",
    "composite": true,
    "types": [
      "@webgpu/types"
    ],
    "paths": {
      "@adobe/ecs": [
        "../interface/index.ts"
      ]
    },
    "lib": [
