{
  "name": "@adobe/data-ecs",
  "version": "0.10.22",
  "description": "Adobe data ECS",
  "type": "module",
  "sideEffects": false,
  "private": true,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b -w --preserveWatchOutput",
    "typecheck": "tsc -b",
    "test": "pnpm exec playwright install chromium && vitest --run",
    "test:perf": "pnpm exec playwright install chromium && vitest --run --workspace vitest.perf.workspace.ts",
    "perf": "vite build --config vite.perf.config.ts --logLevel warn && node dist/perf/run.js",
    "sample": "vite --config vite.sample.config.ts"
  },
  "devDependencies": {
    "@types/estree": "^1.0.5",
    "@types/node": "^20.11.0",
    "@vitest/browser": "^1.6.0",
    "@webgpu/types": "^0.1.61",
    "playwright": "^1.46.1",
    "typescript": "^5.8.3",
    "vite": "^5.1.1",
    "vitest": "^1.6.0"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./compiler": {
      "import": "./dist/compiler/index.js",
      "types": "./dist/compiler/index.d.ts"
    },
    "./components": {
      "types": "./dist/component/types.d.ts"
    },
    "./resources": {
      "types": "./dist/resource/types.d.ts"
    },
    "./systems": {
      "types": "./dist/system/types.d.ts"
    },
    "./rules": {
      "types": "./dist/rule/types.d.ts"
    },
    "./finalizers": {
      "types": "./dist/finalizer/types.d.ts"
    },
    "./traits": {
      "types": "./dist/trait/types.d.ts"
    }
  }
}
