{
  "extends": "../../../data/tsconfig-base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "../../dist/interface",
    "composite": true,
    "types": [
      "@webgpu/types"
    ],
    "paths": {
      "@adobe/data-ecs": [
        "./index.ts"
      ],
      "@adobe/data-ecs/*": [
        "./index.ts"
      ]
    },
    "lib": [
      "ES2024",
      "ESNext.Disposable",
      "DOM",
      "DOM.Iterable"
    ]
  },
  "include": [
    "**/*"
  ]
}
