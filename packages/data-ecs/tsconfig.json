{
  "extends": "../data/tsconfig-base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "composite": true,
    "types": [
      "@webgpu/types"
    ],
    "paths": {
      "@adobe/data-ecs": [
        "./src/index.ts"
      ]
    },
    "lib": [
      "ES2024",
      "ESNext.Disposable",
      "DOM",
      "DOM.Iterable"
    ]
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "src/types"
  ],
  "references": [
    {
      "path": "./src/types"
    }
  ]
}
