{
  "name": "data-gpu-samples",
  "version": "0.10.6",
  "description": "WebGPU samples built on @adobe/data-gpu",
  "type": "module",
  "private": true,
  "pages": [
    { "from": "dist", "to": "gpu-samples" }
  ],
  "scripts": {
    "predev": "pnpm --filter @adobe/data-gpu build",
    "dev": "vite",
    "dev:all": "pnpm --filter @adobe/data-gpu build && pnpm --parallel --filter @adobe/data --filter @adobe/data-gpu --filter data-gpu-samples run dev",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@adobe/data": "workspace:*",
    "@adobe/data-gpu": "workspace:*",
    "@adobe/data-lit": "workspace:*",
    "lit": "^3.3.1"
  },
  "devDependencies": {
    "@webgpu/types": "^0.1.61",
    "typescript": "^5.8.3",
    "vite": "^8.3.4",
    "vite-plugin-checker": "^0.14.5"
  }
}
