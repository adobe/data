{
  // Runtime: pure data declarations (data/). Composite so higher layers reference it;
  // a data file importing spec/, ecs/ or any test file is a compile error (TS6307: not
  // in this project).
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "./.tsbuild/data",
    "rootDir": "src"
  },
  "include": ["src/features/*/data/**/*", "src/features/*/services/**/*"],
  "exclude": ["**/*.test.ts", "**/*.type-test.ts"]
}
