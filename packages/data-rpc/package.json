{
    "name": "@adobe/data-rpc",
    "version": "0.10.11",
    "description": "Schema-driven, bidirectional projection of @adobe/data async data services across a boundary (iframe / MessagePort / Worker). Only Data crosses the wire.",
    "type": "module",
    "sideEffects": false,
    "private": false,
    "publishConfig": {
        "registry": "https://registry.npmjs.org/",
        "access": "public"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "cp ../../LICENSE . 2>/dev/null || true; tsc -b",
        "clean": "rm -rf dist node_modules",
        "dev": "tsc -b -w --preserveWatchOutput",
        "test": "vitest --run",
        "typecheck": "tsc -b"
    },
    "dependencies": {
        "@adobe/data": "workspace:*"
    },
    "devDependencies": {
        "jsdom": "^24.1.0",
        "typescript": "^5.8.3",
        "vitest": "^1.6.0"
    },
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
        }
    }
}
