{
  "name": "ecs-monorepo",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "docs": "pnpm -r run docs",
    "dev": "pnpm -r --parallel run dev",
    "check:workspace": "node scripts/check-workspace-conventions.mjs && node --test 'scripts/*.test.mjs'",
    "publish": "sh -c 'for x in \"$@\"; do OTP=\"$x\"; done; export NPM_CONFIG_OTP=\"$OTP\"; pnpm -r run build && pnpm -r publish --no-git-checks --access public' sh"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "marked": "^18.1.1",
    "pnpm": "^9.0.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "pnpm": {
    "overrides": {
      "@oxc-parser/binding-wasm32-wasip1>@napi-rs/wasm-runtime": "1.2.5",
      "@oxc-transform/binding-wasm32-wasip1>@napi-rs/wasm-runtime": "1.2.5"
    }
  }
}
