{
  "name": "@adobe/ecs",
  "version": "0.0.0",
  "description": "Adobe ECS",
  "type": "module",
  "sideEffects": false,
  "private": true,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b -w --preserveWatchOutput",
    "typecheck": "tsc -b",
    "test": "pnpm exec playwright install chromium && vitest --run",
    "test:perf": "pnpm exec playwright install chromium && vitest --run --config vitest.perf.config.ts",
    "perf": "node scripts/perf.mjs",
    "perf:browser": "node scripts/perf.mjs --browser",
    "perf:report": "node scripts/perf.mjs --report",
    "sample": "vite --config vite.sample.config.ts"
  },
  "devDependencies": {
    "@types/estree": "^1.0.5",
    "@types/node": "^25.6.0",
    "@vitest/browser-playwright": "^5.0.5",
    "@webgpu/types": "^0.1.61",
    "playwright": "^1.64.1",
    "typescript": "^5.8.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "vite": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./compiler": {
      "import": "./dist/implementation/compiler/index.js",
      "types": "./dist/implementation/compiler/index.d.ts"
    }
  }
}
